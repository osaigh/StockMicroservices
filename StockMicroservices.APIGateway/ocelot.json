{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/stock",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "stockapi",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/stock",
      "UpstreamHttpMethod": [ "GET" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": [ "StockMicroservicesAPI" ]
      }
    },
    {
      "DownstreamPathTemplate": "/api/stock/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "stockapi",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/stock/{id}",
      "UpstreamHttpMethod": [ "GET" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": [ "StockMicroservicesAPI" ]
      }
    },
    {
      "DownstreamPathTemplate": "/api/stockmarket",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "stockapi",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/stockmarket",
      "UpstreamHttpMethod": [ "PUT" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": [ "StockMicroservicesAPI" ]
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:44405"
  }
}
